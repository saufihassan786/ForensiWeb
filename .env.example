# ==============================================================================
# ForensiWeb — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and adjust values for your local environment.
# NEVER commit the actual '.env' file or any real secrets to version control.
#
# All development services must bind to 127.0.0.1 (localhost) to preserve
# laboratory isolation and prevent external exposure.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Runtime environment: development | testing | production
ENVIRONMENT=development
# Debug mode (true enables verbose error traces; false in production)
DEBUG=true
# Backend API service host and port
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1
# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Frontend development server port
FRONTEND_PORT=5173

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=forensiweb
POSTGRES_USER=forensiweb_user
# Safe placeholder password for local development only
POSTGRES_PASSWORD=insecure_dev_password_change_in_prod
# Async connection URL for FastAPI / SQLAlchemy
DATABASE_URL=postgresql+asyncpg://forensiweb_user:insecure_dev_password_change_in_prod@127.0.0.1:5432/forensiweb
# Sync connection URL for Alembic database migrations
DATABASE_URL_SYNC=postgresql://forensiweb_user:insecure_dev_password_change_in_prod@127.0.0.1:5432/forensiweb

# ------------------------------------------------------------------------------
# 3. EVIDENCE STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# Root evidence storage directory
EVIDENCE_ROOT_DIR=./data/evidence
# Read-only original pristine evidence directory
EVIDENCE_ORIGINAL_DIR=./data/evidence/original
# Analysis working copy directory
EVIDENCE_WORKING_DIR=./data/evidence/working
# Derived artifacts (normalized events, timeline data, detections)
EVIDENCE_DERIVED_DIR=./data/evidence/derived
# Final forensic reports output directory
REPORTS_DIR=./data/reports
# Maximum allowed single evidence artifact upload size in megabytes
MAX_EVIDENCE_UPLOAD_MB=100

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Application secret key for signing JWT tokens and session data
# In production, replace with a 64+ character cryptographically secure secret
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production-only-for-dev
# JWT signing algorithm
JWT_ALGORITHM=HS256
# Access token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Cryptographic hash algorithm for forensic evidence integrity (SHA-256 mandatory)
INTEGRITY_HASH_ALGORITHM=SHA-256

# ------------------------------------------------------------------------------
# 5. LABORATORY & SCENARIO CONFIGURATION
# ------------------------------------------------------------------------------
# Dedicated Docker bridge network for isolated scenario execution
LAB_NETWORK_NAME=forensiweb-lab-net
# Deliberately vulnerable target container host and internal port
LAB_VULN_APP_HOST=127.0.0.1
LAB_VULN_APP_PORT=5000
# Lab container resource limits
LAB_CONTAINER_MEMORY_LIMIT=512m
LAB_CONTAINER_CPU_LIMIT=1.0
# Sample lab evidence and scenario scripts directory
LAB_DATA_DIR=./lab/sample-evidence
# Enforce non-egress isolation on lab container network (true mandatory)
LAB_NETWORK_INTERNAL_ONLY=true

# ------------------------------------------------------------------------------
# 6. LOGGING CONFIGURATION
# ------------------------------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Structured log output format: json | console
LOG_FORMAT=console
# Application logs directory
LOG_DIR=./logs

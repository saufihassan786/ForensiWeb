# ==============================================================================
# ForensiWeb — Git Ignore Rules (.gitignore)
# ==============================================================================
# Adheres to docs/rules.md (Section 35 & 36) and docs/architecture.md
# Prevents committing secrets, temporary data, caches, and runtime artifacts.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secrets (CRITICAL SECURITY)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
# Do NOT ignore the example template
!.env.example

# Credentials, Keys, and Certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
id_ed25519*
secrets/
*.secret

# ------------------------------------------------------------------------------
# 2. Python Runtime & Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
htmlcov/

# Virtual Environments
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# Typing & Linters
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------------------------------------------
# 3. Node & Frontend (apps/frontend)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend build outputs
apps/frontend/dist/
apps/frontend/dist-ssr/
apps/frontend/.vite/
*.local

# ------------------------------------------------------------------------------
# 4. Runtime Evidence, Reports & Data (FORENSIC PRESERVATION)
# ------------------------------------------------------------------------------
# Ignore runtime working copies and derived artifacts, but preserve directories via .gitkeep
data/evidence/working/*
!data/evidence/working/.gitkeep

data/evidence/derived/*
!data/evidence/derived/.gitkeep

data/reports/*
!data/reports/.gitkeep

# Runtime logs
logs/
*.log
# Keep sample evidence logs in lab and test fixtures
!lab/sample-evidence/**
!lab/fixtures/**
!tests/fixtures/**
tests/fixtures/**/__pycache__/
*.tsbuildinfo

# SQLite / Local dev databases
*.sqlite
*.sqlite3
*.db
*.db-journal

# ------------------------------------------------------------------------------
# 5. Operating System & IDE Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editors & IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~
*.bak

# Antigravity IDE local runtime cache
.gemini/

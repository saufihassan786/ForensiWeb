# ==============================================================================
# ForensiWeb — Git Attributes Configuration (.gitattributes)
# ==============================================================================
# Enforces consistent line endings (LF) across Windows, Linux, and Docker
# environments, preventing container shell script execution failures.
# ==============================================================================

# Auto-detect text files and normalize to LF
* text=auto eol=lf

# Code files must always have LF line endings
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.sql text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf

# Shell scripts and Makefiles MUST have LF (CRLF breaks Docker/Linux execution)
*.sh text eol=lf
*.bash text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf

# Windows batch/cmd scripts require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.tar binary
*.gz binary
*.zip binary
*.pyc binary
